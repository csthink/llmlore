<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>llmlore — combined dashboard</title>
<style>
  :root {
    --bg: #0d1117; --panel: #161b22; --border: #30363d;
    --text: #e6edf3; --muted: #8b949e; --accent: #58a6ff; --stale: #6e7681;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  header { padding: 24px 28px 0; border-bottom: 1px solid var(--border); }
  header h1 { margin: 0 0 4px; font-size: 20px; }
  header .sub { color: var(--muted); font-size: 13px; }
  .tabs { display: flex; gap: 4px; margin-top: 16px; }
  .tab {
    background: none; border: none; border-bottom: 2px solid transparent;
    color: var(--muted); font: inherit; font-size: 14px; padding: 8px 14px;
    cursor: pointer;
  }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--text); border-bottom-color: var(--accent); }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 28px 64px; }
  .panel.hidden { display: none; }
  section { margin-bottom: 36px; }
  section h2 { font-size: 16px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .stats { display: flex; flex-wrap: wrap; gap: 16px; }
  .stat { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 14px 18px; min-width: 130px; }
  .stat .n { font-size: 22px; font-weight: 600; }
  .stat .l { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .dist { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .chip { background: var(--panel); border: 1px solid var(--border); border-radius: 999px; padding: 3px 10px; font-size: 12px; color: var(--muted); }
  .chip b { color: var(--text); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); font-size: 13px; }
  th { color: var(--muted); font-weight: 500; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .lang { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
  .stale { color: var(--stale); }
  .stale-tag { color: var(--stale); font-size: 11px; border: 1px solid var(--stale); border-radius: 4px; padding: 0 5px; margin-left: 6px; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 760px) { .two-col { grid-template-columns: 1fr; } }
  .filters { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; }
  .filters label { font-size: 12px; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
  .filters select { background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; }
  .filters .check { flex-direction: row; align-items: center; gap: 6px; margin-top: 16px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; margin-top: 16px; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 8px; }
  .card.hidden { display: none; }
  .card .title { font-size: 15px; font-weight: 600; }
  .card .desc { color: var(--muted); font-size: 13px; }
  .card .summary { font-size: 13px; }
  .card .meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 12px; color: var(--muted); margin-top: auto; }
  .tag { background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 1px 7px; font-size: 11px; color: var(--text); }
  .tag.type { border-color: var(--accent); color: var(--accent); }
  .empty { color: var(--muted); font-style: italic; padding: 8px 0; }
  .empty-state { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 28px; color: var(--muted); }
  .empty-state h2 { border: none; margin-top: 0; color: var(--text); }
  .empty-state code { background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; color: var(--text); }
  .count-note { color: var(--muted); font-size: 12px; margin-top: 8px; }
  .filters input[type="text"] { background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; min-width: 220px; }
  .filters .f-search { min-width: 240px; }
  .topic-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 12px; }
  .topic-bar-label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .f-topics { display: flex; flex-wrap: wrap; gap: 6px; }
  .topic-chip { background: var(--bg); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; font: inherit; font-size: 12px; color: var(--muted); cursor: pointer; }
  .topic-chip:hover { color: var(--text); }
  .topic-chip.sel { border-color: var(--accent); color: var(--accent); }
  .dist .chip[data-topic] { cursor: pointer; }
  .dist .chip[data-topic]:hover { border-color: var(--accent); }
  .dist .chip.sel { border-color: var(--accent); color: var(--accent); }
  .card .tag[data-topic], .card .tag.type { cursor: pointer; }
  .card .tag[data-topic]:hover, .card .tag.type:hover { border-color: var(--accent); }
  .card .tag.sel { border-color: var(--accent); color: var(--accent); }
  .show-more { display: block; margin: 20px auto 0; background: var(--panel); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 8px 20px; font: inherit; cursor: pointer; }
  .show-more:hover { border-color: var(--accent); }
  .grid-empty { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 24px; color: var(--muted); text-align: center; margin-top: 16px; }
  .grid-empty p { margin: 0 0 12px; }
  .clear-filters { background: none; border: 1px solid var(--accent); color: var(--accent); border-radius: 6px; padding: 6px 14px; font: inherit; cursor: pointer; }
  .clear-filters:hover { background: rgba(88,166,255,.1); }
</style>
</head>
<body>
<header>
  <h1>llmlore</h1>
  <div class="sub">A curated catalog of repositories for learning to build with LLMs &amp; AI · mode: {{.Mode}} · generated {{.GeneratedAt}}</div>
  <nav class="tabs">
    <button class="tab active" data-tab="catalog">Catalog</button>
    <button class="tab" data-tab="mystars">My stars</button>
    <button class="tab" data-tab="cross">Cross</button>
  </nav>
</header>
<main>

  <div class="panel" data-panel="catalog">
    {{template "panelBody" .Catalog}}
  </div>

  <div class="panel hidden" data-panel="mystars">
    {{if .HasStars}}
      {{template "panelBody" .MyStars}}
    {{else}}
      {{template "starsEmpty" .}}
    {{end}}
  </div>

  <div class="panel hidden" data-panel="cross">
    {{if .HasStars}}
      {{template "crossBody" .Cross}}
    {{else}}
      {{template "starsEmpty" .}}
    {{end}}
  </div>

</main>
<script>
  (function () {
    // PROPOSAL-006 / T11. Each tab panel owns its own search/sort/filter/page
    // state; only the active tab serializes into location.hash, so a reload or a
    // shared link restores the same view. The hash holds filter keywords only —
    // never repo contents or personal data. Without JS none of this runs: the
    // server emits every card visible, so the grid degrades gracefully.
    var PAGE_SIZE = 60;
    var DEFAULT_SORT = "stars-desc";

    // Capture the incoming hash BEFORE wiring panels, because panel setup writes
    // the hash and would otherwise clobber a shared "#mystars?..." link.
    var initial = parseHash();

    var panels = {};   // tab name -> controller
    var activeTab = "catalog";

    function parseHash() {
      var h = (location.hash || "").replace(/^#/, "");
      if (!h) { return null; }
      var qi = h.indexOf("?");
      var tab = qi < 0 ? h : h.slice(0, qi);
      var params = {};
      if (qi >= 0) {
        h.slice(qi + 1).split("&").forEach(function (kv) {
          if (!kv) { return; }
          var i = kv.indexOf("=");
          var k = i < 0 ? kv : kv.slice(0, i);
          var v = i < 0 ? "" : decodeURIComponent(kv.slice(i + 1).replace(/\+/g, " "));
          params[k] = v;
        });
      }
      return { tab: tab, params: params };
    }

    function setHash(hash) {
      if (history.replaceState) { history.replaceState(null, "", hash); }
      else { location.hash = hash; }
    }

    function optionExists(sel, val) {
      if (!val) { return false; }
      for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === val) { return true; }
      }
      return false;
    }

    function setupPanel(panelEl) {
      var name = panelEl.getAttribute("data-panel");
      var search = panelEl.querySelector(".f-search");
      if (!search) { return null; } // cross / empty-state panel: no filter bar

      var typeSel = panelEl.querySelector(".f-type");
      var langSel = panelEl.querySelector(".f-language");
      var activeChk = panelEl.querySelector(".f-active");
      var sortSel = panelEl.querySelector(".f-sort");
      var grid = panelEl.querySelector(".cards");
      var shownEl = panelEl.querySelector(".shown-count");
      var totalEl = panelEl.querySelector(".total-count");
      var showMore = panelEl.querySelector(".show-more");
      var gridEmpty = panelEl.querySelector(".grid-empty");
      var topicChips = Array.prototype.slice.call(panelEl.querySelectorAll(".f-topics .topic-chip"));
      var cards = Array.prototype.slice.call(panelEl.querySelectorAll(".cards .card"));

      cards.forEach(function (c) {
        var a = c.querySelector(".title a");
        c._name = (a ? a.textContent : "").trim().toLowerCase();
        c._stars = parseInt(c.getAttribute("data-stars"), 10) || 0;
        c._pushed = c.getAttribute("data-pushed") || "";
        c._search = c.getAttribute("data-search") || "";
        c._topics = (c.getAttribute("data-topics") || "").split(" ").filter(Boolean);
        c._type = c.getAttribute("data-type") || "";
        c._lang = c.getAttribute("data-language") || "";
        c._active = c.getAttribute("data-active") === "true";
      });

      var sorted = cards.slice();
      var selectedTopics = {};
      var page = 1;

      function topicList() {
        var out = [];
        for (var k in selectedTopics) { if (selectedTopics[k]) { out.push(k); } }
        out.sort();
        return out;
      }

      // Pushed-date comparator with empty dates always sorting last, in both
      // directions.
      function cmpPushed(a, b, desc) {
        var pa = a._pushed, pb = b._pushed;
        if (pa === pb) { return 0; }
        if (pa === "") { return 1; }
        if (pb === "") { return -1; }
        if (desc) { return pa < pb ? 1 : -1; }
        return pa < pb ? -1 : 1;
      }

      // resort reorders the DOM so pagination can simply reveal the first N
      // matches in document order (filter never changes relative order).
      function resort() {
        var s = sortSel.value;
        sorted.sort(function (a, b) {
          switch (s) {
            case "stars-asc": return a._stars - b._stars;
            case "pushed-desc": return cmpPushed(a, b, true);
            case "pushed-asc": return cmpPushed(a, b, false);
            case "name": return a._name < b._name ? -1 : a._name > b._name ? 1 : 0;
            default: return b._stars - a._stars;
          }
        });
        sorted.forEach(function (c) { grid.appendChild(c); });
      }

      function matches(c, q) {
        if (q && c._search.indexOf(q) === -1) { return false; }
        var ts = topicList();
        if (ts.length) {
          var hit = false;
          for (var i = 0; i < ts.length; i++) {
            if (c._topics.indexOf(ts[i]) !== -1) { hit = true; break; }
          }
          if (!hit) { return false; } // OR semantics: any selected topic matches
        }
        if (typeSel.value && c._type !== typeSel.value) { return false; }
        if (langSel.value && c._lang !== langSel.value) { return false; }
        if (activeChk.checked && !c._active) { return false; }
        return true;
      }

      function highlight() {
        topicChips.forEach(function (chip) {
          chip.classList.toggle("sel", !!selectedTopics[chip.getAttribute("data-topic")]);
        });
        Array.prototype.forEach.call(panelEl.querySelectorAll(".dist .chip[data-topic]"), function (chip) {
          chip.classList.toggle("sel", !!selectedTopics[chip.getAttribute("data-topic")]);
        });
        cards.forEach(function (c) {
          Array.prototype.forEach.call(c.querySelectorAll(".tag[data-topic]"), function (tag) {
            tag.classList.toggle("sel", !!selectedTopics[tag.getAttribute("data-topic")]);
          });
          var typeTag = c.querySelector(".tag.type");
          if (typeTag) {
            typeTag.classList.toggle("sel", !!typeSel.value && typeTag.getAttribute("data-type-tag") === typeSel.value);
          }
        });
      }

      // Order is fixed: filter -> sort (already applied to the DOM) -> page.
      function apply() {
        var q = search.value.trim().toLowerCase();
        var limit = page * PAGE_SIZE;
        var matched = 0, revealed = 0;
        sorted.forEach(function (c) {
          if (matches(c, q)) {
            matched++;
            if (revealed < limit) { c.classList.remove("hidden"); revealed++; }
            else { c.classList.add("hidden"); }
          } else {
            c.classList.add("hidden");
          }
        });
        if (shownEl) { shownEl.textContent = revealed; }
        if (totalEl) { totalEl.textContent = matched; }
        if (showMore) { showMore.hidden = matched <= limit; }
        if (gridEmpty) { gridEmpty.hidden = matched !== 0; }
        highlight();
        if (activeTab === name) { writeHash(); }
      }

      function writeHash() {
        var parts = [];
        var q = search.value.trim();
        if (q) { parts.push("q=" + encodeURIComponent(q)); }
        var ts = topicList();
        if (ts.length) { parts.push("topic=" + ts.map(encodeURIComponent).join(",")); }
        if (typeSel.value) { parts.push("type=" + encodeURIComponent(typeSel.value)); }
        if (langSel.value) { parts.push("lang=" + encodeURIComponent(langSel.value)); }
        if (activeChk.checked) { parts.push("active=1"); }
        if (sortSel.value && sortSel.value !== DEFAULT_SORT) { parts.push("sort=" + sortSel.value); }
        if (page > 1) { parts.push("page=" + page); }
        setHash("#" + name + (parts.length ? ("?" + parts.join("&")) : ""));
      }

      function clearFilters() {
        search.value = "";
        selectedTopics = {};
        typeSel.value = "";
        langSel.value = "";
        activeChk.checked = false;
        page = 1;
        apply();
      }

      function onFilterChange() { page = 1; apply(); }
      search.addEventListener("input", onFilterChange);
      typeSel.addEventListener("change", onFilterChange);
      langSel.addEventListener("change", onFilterChange);
      activeChk.addEventListener("change", onFilterChange);
      sortSel.addEventListener("change", function () { page = 1; resort(); apply(); });
      if (showMore) { showMore.addEventListener("click", function () { page++; apply(); }); }
      Array.prototype.forEach.call(panelEl.querySelectorAll(".clear-filters"), function (b) {
        b.addEventListener("click", clearFilters);
      });

      // Delegated clicks: distribution chips, topic chips, and card topic/type
      // tags all drive the filters. Climb to the element carrying the data attr
      // so clicks on inner nodes (e.g. a chip's <b>) still register.
      panelEl.addEventListener("click", function (e) {
        var t = e.target;
        while (t && t !== panelEl && !t.hasAttribute("data-topic") && !t.hasAttribute("data-type-tag")) {
          t = t.parentNode;
        }
        if (!t || t === panelEl) { return; }
        if (t.hasAttribute("data-topic")) {
          e.preventDefault();
          var topic = t.getAttribute("data-topic");
          if (selectedTopics[topic]) { delete selectedTopics[topic]; }
          else { selectedTopics[topic] = true; }
          page = 1; apply();
        } else if (t.hasAttribute("data-type-tag")) {
          e.preventDefault();
          var ty = t.getAttribute("data-type-tag");
          typeSel.value = (typeSel.value === ty) ? "" : ty;
          page = 1; apply();
        }
      });

      function restore(params) {
        search.value = params.q || "";
        selectedTopics = {};
        if (params.topic) {
          params.topic.split(",").forEach(function (x) { if (x) { selectedTopics[x] = true; } });
        }
        typeSel.value = optionExists(typeSel, params.type) ? params.type : "";
        langSel.value = optionExists(langSel, params.lang) ? params.lang : "";
        activeChk.checked = params.active === "1";
        sortSel.value = optionExists(sortSel, params.sort) ? params.sort : DEFAULT_SORT;
        var p = parseInt(params.page, 10);
        page = p > 0 ? p : 1;
        resort();
        apply();
      }

      resort();
      apply();

      return { name: name, restore: restore, refreshHash: writeHash };
    }

    Array.prototype.forEach.call(document.querySelectorAll(".panel"), function (panelEl) {
      var ctrl = setupPanel(panelEl);
      if (ctrl) { panels[ctrl.name] = ctrl; }
    });

    var tabs = Array.prototype.slice.call(document.querySelectorAll(".tab"));
    var panelEls = Array.prototype.slice.call(document.querySelectorAll(".panel"));

    function activate(tabName, params) {
      var known = false;
      tabs.forEach(function (t) { if (t.getAttribute("data-tab") === tabName) { known = true; } });
      if (!known) { tabName = "catalog"; }
      activeTab = tabName;
      tabs.forEach(function (t) { t.classList.toggle("active", t.getAttribute("data-tab") === tabName); });
      panelEls.forEach(function (p) { p.classList.toggle("hidden", p.getAttribute("data-panel") !== tabName); });
      var ctrl = panels[tabName];
      if (ctrl && params) { ctrl.restore(params); }
      else if (ctrl) { ctrl.refreshHash(); }
      else { setHash("#" + tabName); } // cross / non-filter panel: tab name only
    }

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () { activate(tab.getAttribute("data-tab"), null); });
    });

    if (initial) { activate(initial.tab, initial.params); }
    else { activate("catalog", null); }
  })();
</script>
</body>
</html>

{{define "starsEmpty"}}
<div class="empty-state">
  <h2>No local stars yet</h2>
  <p>This tab shows your own starred repositories, which stay on this machine and are never committed.</p>
  <p>Run <code>llmlore stars sync</code> to fetch your stars, then <code>llmlore stars organize</code> to label them by type and topic. Reopen this dashboard and the My stars and Cross tabs will populate.</p>
</div>
{{end}}

{{define "panelBody"}}
  <section class="overview">
    <h2>Overview</h2>
    <div class="stats">
      <div class="stat"><div class="n">{{.Total}}</div><div class="l">Total repos</div></div>
      <div class="stat"><div class="n">{{.NewThisRound}}</div><div class="l">New this round</div></div>
      <div class="stat"><div class="n">{{.Mode}}</div><div class="l">Mode</div></div>
    </div>
    <div class="dist">
      {{range .TopicDist}}<span class="chip" data-topic="{{.Label}}">{{.Label}} <b>{{.N}}</b></span>{{end}}
      {{if not .TopicDist}}<span class="empty">No topics yet.</span>{{end}}
    </div>
  </section>

  <section class="top">
    <h2>Top by stars</h2>
    {{if .TopByStars}}
    <table>
      <thead><tr><th>#</th><th>Repository</th><th>Language</th><th class="num">Stars</th></tr></thead>
      <tbody>
        {{range .TopByStars}}
        <tr{{if .Stale}} class="stale"{{end}}>
          <td class="num">{{.Rank}}</td>
          <td><a href="{{.URL}}">{{.ID}}</a>{{if .Stale}}<span class="stale-tag">stale</span>{{end}}</td>
          <td><span class="lang" style="background:{{.LangColor}}"></span>{{if .Language}}{{.Language}}{{else}}—{{end}}</td>
          <td class="num">{{.StarsText}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}<div class="empty">No repositories to rank yet.</div>{{end}}
  </section>

  <section class="trends">
    <h2>Trends</h2>
    <div class="two-col">
      <div>
        <h3>Trending on GitHub</h3>
        <p class="count-note">Repositories currently surfaced by GitHub trending — a "hot on GitHub right now" discovery signal. For windowed magnitude, see Fastest growing.</p>
        {{if .Trending}}
        <table>
          <thead><tr><th>#</th><th>Repository</th><th class="num">Stars</th></tr></thead>
          <tbody>
            {{range .Trending}}
            <tr{{if .Stale}} class="stale"{{end}}>
              <td class="num">{{.Rank}}</td>
              <td><a href="{{.URL}}">{{.ID}}</a></td>
              <td class="num">{{.StarsText}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
        {{else}}<div class="empty">No trending-sourced repositories in this dataset.</div>{{end}}
      </div>
      <div>
        <h3>Fastest growing</h3>
        <p class="count-note">Star gain computed from our own snapshot history.</p>
        {{if .Growing}}
        <table>
          <thead><tr><th>Repository</th><th class="num">+7d</th><th class="num">+30d</th><th class="num">Stars</th></tr></thead>
          <tbody>
            {{range .Growing}}
            <tr>
              <td><a href="{{.URL}}">{{.ID}}</a></td>
              <td class="num">{{.D7}}</td>
              <td class="num">{{.D30}}</td>
              <td class="num">{{.StarsText}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
        {{else}}<div class="empty">Not enough snapshot history to compute growth yet.</div>{{end}}
      </div>
    </div>
  </section>

  <section class="filters-sec">
    <h2>Browse</h2>
    <div class="filters">
      <label>Search
        <input type="text" class="f-search" placeholder="Search name, owner, description…">
      </label>
      <label>Sort
        <select class="f-sort">
          <option value="stars-desc">Stars (high→low)</option>
          <option value="stars-asc">Stars (low→high)</option>
          <option value="pushed-desc">Recently pushed</option>
          <option value="pushed-asc">Least recently pushed</option>
          <option value="name">Name (A→Z)</option>
        </select>
      </label>
      <label>Type
        <select class="f-type"><option value="">All</option>{{range .Types}}<option value="{{.}}">{{.}}</option>{{end}}</select>
      </label>
      <label>Language
        <select class="f-language"><option value="">All</option>{{range .Languages}}<option value="{{.}}">{{.}}</option>{{end}}</select>
      </label>
      <label class="check"><input type="checkbox" class="f-active"> Active only</label>
    </div>
    {{if .Topics}}
    <div class="topic-bar">
      <span class="topic-bar-label">Topics</span>
      <div class="f-topics">{{range .Topics}}<button type="button" class="topic-chip" data-topic="{{.}}">{{.}}</button>{{end}}</div>
    </div>
    {{end}}
    <div class="count-note">Showing <span class="shown-count">{{len .Cards}}</span> of <span class="total-count">{{len .Cards}}</span> repositories</div>
  </section>

  <section class="catalog-sec">
    <div class="cards">
      {{range .Cards}}
      <article class="card" data-type="{{.Type}}" data-topics="{{.TopicsAttr}}" data-language="{{.Language}}" data-active="{{.Active}}" data-stars="{{.Stars}}" data-pushed="{{.PushedAt}}" data-search="{{.SearchAttr}}">
        <div class="title"><a href="{{.URL}}">{{.ID}}</a>{{if .Stale}}<span class="stale-tag">stale</span>{{end}}</div>
        {{if .Summary}}<div class="summary">{{.Summary}}</div>{{end}}
        {{if .Description}}<div class="desc">{{.Description}}</div>{{end}}
        <div class="meta">
          <span class="tag type" data-type-tag="{{.Type}}">{{.Type}}</span>
          {{range .Topics}}<span class="tag" data-topic="{{.}}">{{.}}</span>{{end}}
          <span><span class="lang" style="background:{{.LangColor}}"></span>{{if .Language}}{{.Language}}{{else}}—{{end}}</span>
          <span>★ {{.StarsText}}</span>
          {{if .PushedAt}}<span>pushed {{.PushedAt}}</span>{{end}}
        </div>
      </article>
      {{end}}
    </div>
    <button type="button" class="show-more" hidden>Show more</button>
    <div class="grid-empty" hidden>
      <p>No repositories match these filters.</p>
      <button type="button" class="clear-filters">Clear filters</button>
    </div>
    {{if not .Cards}}<div class="empty">No repositories in this dataset.</div>{{end}}
  </section>
{{end}}

{{define "crossBody"}}
  <section class="cross-starred">
    <h2>Already starred ({{len .AlreadyStarred}})</h2>
    <p class="count-note">Catalog repositories you have already starred. Set LLMLORE_EXCLUDE_STARRED to drop these from discover.</p>
    {{if .AlreadyStarred}}
    <table>
      <thead><tr><th>#</th><th>Repository</th><th>Language</th><th class="num">Stars</th></tr></thead>
      <tbody>
        {{range .AlreadyStarred}}
        <tr>
          <td class="num">{{.Rank}}</td>
          <td><a href="{{.URL}}">{{.ID}}</a></td>
          <td><span class="lang" style="background:{{.LangColor}}"></span>{{if .Language}}{{.Language}}{{else}}—{{end}}</td>
          <td class="num">{{.StarsText}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}<div class="empty">None of the catalog repositories are in your stars yet.</div>{{end}}
  </section>

  <section class="cross-recommended">
    <h2>Recommended ({{len .Recommended}})</h2>
    <p class="count-note">Popular catalog repositories you have not starred yet. Freshness depends on your last <code>llmlore update</code> or <code>llmlore pull</code>.</p>
    {{if .Recommended}}
    <table>
      <thead><tr><th>#</th><th>Repository</th><th>Type</th><th>Language</th><th class="num">Stars</th></tr></thead>
      <tbody>
        {{range .Recommended}}
        <tr>
          <td class="num">{{.Rank}}</td>
          <td><a href="{{.URL}}">{{.ID}}</a></td>
          <td>{{if .Type}}{{.Type}}{{else}}—{{end}}</td>
          <td><span class="lang" style="background:{{.LangColor}}"></span>{{if .Language}}{{.Language}}{{else}}—{{end}}</td>
          <td class="num">{{.StarsText}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}<div class="empty">No recommendations: you have starred everything in the catalog.</div>{{end}}
  </section>
{{end}}
